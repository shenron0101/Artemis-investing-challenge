*.sqlite
*.sqlite3
*.db
*.dump

# ML / binary artifacts
*.onnx
*.pt
*.pth
*.bin
*.npy
*.npz
*.feather

# Keep processed CSVs (small results files)
!data/processed/*.csv

# Ruff / linting cache
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Reports (generated outputs, not source)
reports/*.pdf
reports/*.html

# Images and HTML (generated/output files)
*.png
*.html

# Research PDFs are large local source documents; keep notes/scripts in git.
02_Research/*.pdf

# Paper-reproduction generated outputs. Source scripts and REPORT.md stay tracked.
