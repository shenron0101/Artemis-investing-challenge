# Python
.venv/
01_Data_Collection/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Environment
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# Data — raw API responses and large processed files
data/raw/
data/interim/
data/processed/*.parquet
01_Data_Collection/data/raw/
01_Data_Collection/data/clean/*.parquet
01_Data_Collection/data/clean/*.csv
01_Data_Collection/data/logs/

# Large local exports / snapshots
01_Data_Collection/data/export/
01_Data_Collection/data/tmp/
01_Data_Collection/data/cache/

# Archives and packaged artifacts (often very large)
*.zip
*.tar
*.tar.gz
*.tgz
*.bz2
*.7z
*.rar

# Database/data dumps
*.sqlite
*.sqlite3
*.db
*.dump

# ML / binary artifacts
*.onnx
*.pt
*.pth
*.bin
*.npy
*.npz
*.feather

# Keep processed CSVs (small results files)
!data/processed/*.csv

# Ruff / linting cache
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Reports (generated outputs, not source)
reports/*.pdf
reports/*.html

# Images and HTML (generated/output files)
*.png
*.html

# Exception: factor visualisation charts are referenced by the RESULTS.md docs
!12_factor_viz/**/*.png

# Exception: figures embedded in the competition report
!figures/*.png
!16_reports/figures/*.png

# Exception: figures regenerated from metrics.json for the report
!14_regime_factor_strategy/artifacts/figures/*.png
!15_factor_ensemble_strategy/artifacts/figures/*.png

# Stage 06 artifacts are gitignored (regenerable from 01_Data_Collection)
06_artemis_econometrics/artifacts/
06_artemis_econometrics/figures/
!06_artemis_econometrics/artifacts/**/.gitkeep

# Data artifacts — CSV/parquet are large and regenerable, kept out of version control
*.csv
*.parquet
