__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Environment
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# Data — raw API responses and large processed files
data/raw/
data/interim/
data/processed/*.parquet
01_Data_Collection/data/raw/
