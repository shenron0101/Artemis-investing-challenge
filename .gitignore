# Large local exports / snapshots
01_Data_Collection/data/export/
01_Data_Collection/data/tmp/
01_Data_Collection/data/cache/

# Archives and packaged artifacts (often very large)
*.zip
*.tar
*.tar.gz
*.tgz
*.bz2
*.7z
*.rar

# Database/data dumps
*.sqlite
*.sqlite3
*.db
*.dump

# ML / binary artifacts
*.onnx
*.pt
*.pth
*.bin
*.npy
*.npz
*.feather

# Keep processed CSVs (small results files)
!data/processed/*.csv

# Ruff / linting cache
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Reports (generated outputs, not source)
reports/*.pdf
reports/*.html

# Images and HTML (generated/output files)
*.png
*.html
