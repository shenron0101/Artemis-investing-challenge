# Local gitignore for the 08_nalfp stage.
#
# The root .gitignore is conservative — it excludes *.png, *.html and all
# stage artifacts. For this stage we want the published artefacts checked in
# (parquet outputs, PNG figures, the LaTeX source + compiled PDF) so the
# competition submission is self-contained and reproducible. CSV duplicates of
# parquet, plotly HTML duplicates of PNG, and LaTeX build intermediates stay
# out of git.

# Python build artefacts
__pycache__/
*.py[cod]

# LaTeX build intermediates (keep the .tex source and .pdf output)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# CSV duplicates of the canonical parquet artifacts
artifacts/data/*.csv

# Plotly HTML duplicates of the canonical PNG figures
figures/**/*.html

# Override the root .gitignore so the PNGs and PDFs *under this stage*
# (which are the figures embedded in the paper) are tracked.
!figures/**/*.png
!paper/*.pdf
